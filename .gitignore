# Runs and scratch are local working state (checkpoints, prob dumps, debug pics,
# one-off probes). Small provenance JSONs are force-added selectively; everything
# else under these trees stays out of the repo and off GitHub.
runs/
scratch/
.inductor/

# Belt and braces: never let binaries or rendered samples in, anywhere.
*.pt
*.npy
*.npz
*.pkl
debugpics/
*.ckpt

# Pause/stop flags are runtime state
.PAUSE
.PAUSE.txt
.PUASE
.PUASE.txt
PAUSE

# Python
__pycache__/
*.py[cod]
.env/
.venv/

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Internal assistant notes, not for public release
AGENTS.md
CURRENT-ASSISTANTS.md
REWARDS.md
poked-update.md

# Moved-out legacy/deprecated material, kept on disk only
.old/
